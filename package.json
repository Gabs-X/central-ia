{
  "name": "central-ia",
  "version": "0.3.2",
  "description": "Central de IA para o Windows: orquestra Claude Code e Codex com roteamento de modelo e gestão de cota.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.gabsx.central-ia",
    "productName": "Central IA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Central IA",
      "artifactName": "Central-IA-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Central-IA-Portatil-${version}.${ext}"
    },
    "afterPack": "build/after-pack.js"
  },
  "author": "Gabs-X",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  }
}
